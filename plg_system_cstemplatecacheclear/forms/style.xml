<?xml version="1.0" encoding="utf-8"?>
<!--
    Added to a site template style's edit screen by the plugin, unless the
    template already declares a "clearcacheonsave" field of its own.
-->
<form>
    <fields name="params">
        <fieldset
            name="cstemplatecacheclear"
            label="PLG_SYSTEM_CSTEMPLATECACHECLEAR_FIELDSET_LABEL"
            description="PLG_SYSTEM_CSTEMPLATECACHECLEAR_FIELDSET_DESC"
        >
            <field
                name="clearcacheonsave"
                type="radio"
                label="PLG_SYSTEM_CSTEMPLATECACHECLEAR_FIELD_LABEL"
                description="PLG_SYSTEM_CSTEMPLATECACHECLEAR_FIELD_DESC"
                layout="joomla.form.field.radio.switcher"
                default="1"
                filter="integer"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
        </fieldset>
    </fields>
</form>
